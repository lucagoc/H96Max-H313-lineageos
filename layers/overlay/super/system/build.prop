#
# from device/phh/treble/system.prop
#
ro.adb.secure=1
#Some devices have sdcardfs kernel panicing on 8.0
#Disable for everyone for the moment
ro.sys.sdcardfs=0
persist.sys.overlay.nightmode=true

#Disable debugging strict mode toasts
persist.sys.strictmode.disable=true
persist.sys.phh.mainkeys=0

fw.max_users=10
persist.sys.max_profiles=10
ro.boot.realme.lockstate=0
# end of device/phh/treble/system.prop

#
# ADDITIONAL_BUILD_PROPERTIES
#
ro.treble.enabled=true
persist.debug.dalvik.vm.core_platform_api_policy=just-warn
dalvik.vm.lockprof.threshold=500
net.bt.name=Android
ro.lineage.version=18.1-20250622-UNOFFICIAL-a64_bvS
ro.lineage.releasetype=UNOFFICIAL
ro.lineage.build.version=18.1
ro.modversion=18.1-20250622-UNOFFICIAL-a64_bvS
ro.lineagelegal.url=https://lineageos.org/legal
ro.lineage.display.version=18.1-20250622-UNOFFICIAL-a64_bvS
ro.lineage.build.version.plat.sdk=9
ro.lineage.build.version.plat.rev=0

# Dalvik VM heap configuration for 2GB RAM device
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=384m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# Allwinner USB0 device mode (ADB debug via USB-A to USB-A cable)
persist.vendor.usb0device=1

# --- SurfaceFlinger & HWC hardware direct overlay (bypass GL composition) ---
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=1
debug.sf.latch_unsignaled=1

# --- Cortex-A53 architecture target for ART dex2oat compiler ---
dalvik.vm.isa.arm.variant=cortex-a53
dalvik.vm.isa.arm.features=default

# --- Dexopt compilation policies (AOT machine code compilation) ---
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.first-boot=speed-profile

# --- HWUI / Skia Caches for Mali-G31 (2GB RAM) ---
debug.hwui.renderer=opengl
ro.hwui.use_vulkan=false
ro.hwui.texture_cache_size=48
ro.hwui.layer_cache_size=32
ro.hwui.r_buffer_cache_size=4
ro.hwui.path_cache_size=16
ro.hwui.drop_shadow_cache_size=4

# --- 1080p Native TV Density (xhdpi) ---
ro.sf.lcd_density=320
ro.config.density_override=320

